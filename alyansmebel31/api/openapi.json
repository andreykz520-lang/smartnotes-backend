{
  "openapi": "3.1.0",
  "info": {
    "title": "Альянс Мебель Белгород API",
    "version": "1.0.0",
    "description": "API для поиска мебели из массива Пинскдрев и оформления заявок на консультацию в Белгороде (ул. Благодатная, 80)."
  },
  "servers": [
    {
      "url": "https://alyansmebel31.ru"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "service": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/lead": {
      "post": {
        "summary": "Заявка на консультацию или расчет",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": { "type": "string" },
                  "name": { "type": "string" },
                  "category": { "type": "string" },
                  "comment": { "type": "string" }
                },
                "required": ["phone"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Заявка принята",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
